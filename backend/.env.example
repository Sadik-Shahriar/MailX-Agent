# Free tier models (HY3, DeepSeek v4 Flash, Nemotron, MiMo): https://opencode.ai/zen
ZEN_API_KEY=your_zen_api_key

# Free tier Groq Cloud API key (for Llama 3.3 70B, Llama 3.1 8B): https://console.groq.com
# GROQ_API_KEY=your_groq_api_key

# Official DeepSeek platform API key (for deepseek-v4-flash): https://platform.deepseek.com
# Only used when DeepSeek models are explicitly selected in the extension Settings tab.
# DEEPSEEK_API_KEY=your_deepseek_api_key

# Optional default free Zen model (default: hy3-free)
# ZEN_MODEL=hy3-free

# Development only: emit structured timing/token metadata without email content.
# MAILX_TELEMETRY=1

# Required for authenticated AI requests.
# SUPABASE_URL=https://your-project.supabase.co

# Required for authenticated AI requests. Use a comma-separated allowlist of the
# installed extension origins, never a wildcard.
# MAILX_EXTENSION_ORIGINS=chrome-extension://your-extension-id
